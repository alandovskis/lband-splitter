[Unit]
Description=L-Band Splitter/Combiner Control Daemon
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=splitter
Group=splitter
WorkingDirectory=/opt/splitter
ExecStart=/usr/local/bin/splitter_daemon /etc/splitter/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/log/splitter /var/lib/splitter /tmp
ProtectHome=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Hardware access - GPIO and device files
SupplementaryGroups=gpio dialout

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=splitter

[Install]
WantedBy=multi-user.target